APP_NAME=Adaptive Learning Platform
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5433/adaptive_learning
TEST_DATABASE_URL=postgresql+psycopg://test_user:change_me@localhost:5433/adaptive_learning_test

JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=100
FFMPEG_FRAME_INTERVAL_SECONDS=60
